---
import { Icon } from 'astro-icon/components';
import siteInfo from '~/data/site-info.js';
import NewsLetterSignup from './NewsLetterSignup.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
	bgClass?: string;
}

const { bgClass = 'bg-dark' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

type Link = {
	href: string;
	label: string;
};

type LinkGroup = {
	title: string;
	links: Link[];
};

const groups: LinkGroup[] = [
	{
		title: 'Resources',
		links: [
			{
				label : 'CLI',
				href: `${base}cli`
			},
			{
				label: 'Documentation',
				href: `${base}docs/`,
			},
			{ label: 'Guide', href: `${base}guide/` },
		
		],
	},
	{
		title: 'Learning',
		links: [
			{ label: 'Blog', href: `${base}blog/` },
			{ label: 'Releases', href: `${base}releases/` },
			{ label: 'Docs', href: `${base}docs/` },
		],
	},

	{
		title: 'Legal',
		links: [
			{ label: 'Contributor License Agreement', href: `${base}telemetry/` },
			{ label: 'Logos', href: `${base}logos/` }
		],
	},
];

const socialLinks = siteInfo.socialLinks;
---

<footer class:list={['w-full border-t border-astro-dark-100/20', bgClass]}>
	<div class="w-full max-w-screen-2xl mx-auto px-4 sm:px-8">
		<nav
			aria-label="Secondary"
			class="flex justify-center py-8 md:py-12"
		>
			<div class="w-full max-w-3xl grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-12 justify-items-center text-center sm:text-left">
				{groups.map(({ title, links }, index) => (
					<section class="group flex flex-col">
						<h2
							id={`footerHeading${index}`}
							class="mb-4 label-base leading-none text-white font-semibold"
						>
							{title}
						</h2>
						<ul aria-labelledby={`footerHeading${index}`} class="flex flex-col gap-2">
							{links.map(({ href, label }) => (
								<li>
									<a href={href} class="whitespace-nowrap link flex justify-center sm:justify-start gap-2 items-center">
										{label}
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</nav>
		<hr class="border-astro-gray-500" />
		<nav
			aria-label="Legal"
			class="py-8 flex flex-col-reverse lg:flex-row items-center justify-between gap-4"
		>
			<div class="flex items-center gap-2 text-sm md:gap-4 md:text-base flex-wrap justify-center">
				<a
					target="_blank"
					rel="noopener noreferrer"
					class="link"
					href="https://github.com/preonus-projects/preonus-web/blob/main/LICENSE"
				>
					Apache 2.0 License © {new Date().getFullYear()} 
				</a>
				<a
					class="link"
					target="_blank"
					rel="noopener noreferrer"
					href="https://github.com/preonus-projects/preonus-web/graphs/contributors"
				>
					Preonus Contributors
				</a>
			</div>
			<SocialLinks links={socialLinks} />
		</nav>
	</div>
</footer>
