---
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<div class="preonus-search-root" data-base={base}>
	<button
		type="button"
		class="preonus-search-trigger"
		aria-label="Search Preonus"
		data-open-site-search
	>
		<span class="preonus-search-trigger-left">
			<svg
				class="preonus-search-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="8" />
				<path d="m21 21-4.3-4.3" />
			</svg>
			<span class="preonus-search-placeholder">Search Preonus...</span>
		</span>
		<kbd class="preonus-search-kbd">⌘K</kbd>
	</button>

	<dialog class="preonus-search-dialog" aria-label="Search Preonus" data-site-search-dialog>
		<div class="preonus-search-panel">
			<div class="preonus-search-input-wrap">
				<svg
					class="preonus-search-input-icon"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8" />
					<path d="m21 21-4.3-4.3" />
				</svg>
				<input
					type="search"
					class="preonus-search-input"
					placeholder="Search Preonus docs, guides, blog, releases..."
					autocomplete="off"
					spellcheck="false"
					data-site-search-input
				/>
				<button type="button" class="preonus-search-esc" data-close-site-search>ESC</button>
			</div>

			<div class="preonus-search-results" data-site-search-results></div>

			<div class="preonus-search-footer">
				<span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
				<span><kbd>↵</kbd> open</span>
				<span><kbd>esc</kbd> close</span>
			</div>
		</div>
	</dialog>
</div>

<script>
	interface SearchEntry {
		title: string;
		section?: string;
		url: string;
		category: string;
		excerpt: string;
		body: string;
	}

	let cachedIndex: SearchEntry[] | null = null;
	let indexPromise: Promise<SearchEntry[]> | null = null;

	async function getSearchIndex(base: string): Promise<SearchEntry[]> {
		if (cachedIndex) return cachedIndex;
		if (!indexPromise) {
			indexPromise = fetch(`${base}search-index.json`)
				.then((res) => (res.ok ? res.json() : []))
				.then((data) => {
					cachedIndex = Array.isArray(data) ? data : [];
					return cachedIndex;
				})
				.catch(() => []);
		}
		return indexPromise;
	}

	function escapeHtml(text: string): string {
		return text
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	function highlightMatch(text: string, query: string): string {
		const safe = escapeHtml(text);
		if (!query) return safe;
		const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
		return safe.replace(new RegExp(`(${escapedQuery})`, 'gi'), '<mark>$1</mark>');
	}

	function initSiteSearch() {
		document.querySelectorAll('.preonus-search-root').forEach((root) => {
			if (root.hasAttribute('data-initialized')) return;
			root.setAttribute('data-initialized', 'true');

			const base = root.getAttribute('data-base') || '/';
			const trigger = root.querySelector('[data-open-site-search]');
			const dialog = root.querySelector('[data-site-search-dialog]') as HTMLDialogElement | null;
			const input = root.querySelector('[data-site-search-input]') as HTMLInputElement | null;
			const resultsEl = root.querySelector('[data-site-search-results]');
			const closeBtn = root.querySelector('[data-close-site-search]');

			if (!trigger || !dialog || !input || !resultsEl) return;

			let activeIndex = 0;
			let currentItems: SearchEntry[] = [];

			function renderResults(items: SearchEntry[], query: string) {
				currentItems = items;
				activeIndex = 0;

				if (!items.length) {
					resultsEl.innerHTML = `<div class="preonus-search-empty">No matching results found for "${escapeHtml(query)}".</div>`;
					return;
				}

				resultsEl.innerHTML = items
					.map(
						(item, idx) => `
						<a href="${item.url}" class="preonus-search-item ${idx === 0 ? 'is-active' : ''}" data-search-idx="${idx}">
							<div class="preonus-search-item-top">
								<span class="preonus-search-item-title">${highlightMatch(item.title, query)}</span>
								<span class="preonus-search-item-badge">${escapeHtml(item.category)}</span>
							</div>
							${item.excerpt ? `<p class="preonus-search-item-excerpt">${highlightMatch(item.excerpt, query)}</p>` : ''}
						</a>`,
					)
					.join('');
			}

			function updateActive(next: number) {
				if (!currentItems.length) return;
				activeIndex = (next + currentItems.length) % currentItems.length;
				resultsEl.querySelectorAll('.preonus-search-item').forEach((el, i) => {
					el.classList.toggle('is-active', i === activeIndex);
					if (i === activeIndex) el.scrollIntoView({ block: 'nearest' });
				});
			}

			async function runSearch(rawQuery: string) {
				const entries = await getSearchIndex(base);
				const q = rawQuery.trim().toLowerCase();

				if (!q) {
					const featured = entries.filter((e) => !e.section).slice(0, 8);
					renderResults(featured, '');
					return;
				}

				const terms = q.split(/\s+/).filter(Boolean);
				const scored = entries
					.map((entry) => {
						const titleLower = entry.title.toLowerCase();
						const excerptLower = entry.excerpt.toLowerCase();
						const bodyLower = entry.body.toLowerCase();
						const catLower = entry.category.toLowerCase();

						const matchesAll = terms.every(
							(t) =>
								titleLower.includes(t) ||
								excerptLower.includes(t) ||
								bodyLower.includes(t) ||
								catLower.includes(t),
						);
						if (!matchesAll) return null;

						let score = 0;
						if (titleLower.includes(q)) score += 100;
						if (!entry.section) score += 20;
						for (const t of terms) {
							if (titleLower.includes(t)) score += 30;
							if (excerptLower.includes(t)) score += 15;
							if (bodyLower.includes(t)) score += 5;
						}
						return { entry, score };
					})
					.filter((x): x is { entry: SearchEntry; score: number } => x !== null)
					.sort((a, b) => b.score - a.score)
					.slice(0, 12)
					.map((x) => x.entry);

				renderResults(scored, rawQuery.trim());
			}

			function openModal() {
				dialog.showModal();
				input.value = '';
				runSearch('');
				requestAnimationFrame(() => input.focus());
			}

			trigger.addEventListener('click', openModal);
			closeBtn?.addEventListener('click', () => dialog.close());
			dialog.addEventListener('click', (e) => {
				if (e.target === dialog) dialog.close();
			});

			input.addEventListener('input', () => runSearch(input.value));
			input.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					updateActive(activeIndex + 1);
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					updateActive(activeIndex - 1);
				} else if (e.key === 'Enter' && currentItems[activeIndex]) {
					e.preventDefault();
					window.location.href = currentItems[activeIndex].url;
				}
			});

			window.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					if (dialog.open) dialog.close();
					else openModal();
				}
			});
		});
	}

	initSiteSearch();
	document.addEventListener('astro:after-swap', initSiteSearch);
</script>

<style>
	.preonus-search-root {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
	}

	/* Micronaut / Astro-style uniform search bar across all navbars & screen sizes */
	.preonus-search-root .preonus-search-trigger {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border-radius: 8px;
		border: 1px solid #343841;
		background-color: #17191e;
		color: #bfc1c9;
		font-family: Inter, inter-fallback, system-ui, sans-serif;
		font-size: 14px;
		font-weight: 400;
		line-height: 1;
		cursor: pointer;
		transition:
			border-color 150ms ease,
			color 150ms ease,
			background-color 150ms ease;
	}

	@media (min-width: 1024px) {
		.preonus-search-root .preonus-search-trigger {
			justify-content: space-between;
			gap: 12px;
			width: clamp(216px, 18vw, 248px);
			padding: 0 12px;
			color: #858b98;
		}
	}

	.preonus-search-root .preonus-search-trigger:hover {
		border-color: #545864;
		color: #f2f6fa;
	}

	.preonus-search-root .preonus-search-trigger-left {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-width: 0;
	}

	.preonus-search-root .preonus-search-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}

	.preonus-search-root .preonus-search-placeholder {
		display: none;
		font-size: 14px !important;
		line-height: 1 !important;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.preonus-search-root .preonus-search-kbd {
		display: none;
		font-family: inherit !important;
		font-size: 11.5px !important;
		font-weight: 500 !important;
		line-height: 1 !important;
		padding: 4px 6px !important;
		border-radius: 4px;
		border: 1px solid #343841;
		background-color: #0d0f14;
		color: #bfc1c9;
		flex-shrink: 0;
	}

	@media (min-width: 1024px) {
		.preonus-search-root .preonus-search-placeholder,
		.preonus-search-root .preonus-search-kbd {
			display: inline-block;
		}
	}

	.preonus-search-dialog {
		margin: 8vh auto auto;
		padding: 0;
		width: min(92vw, 40rem);
		border: 1px solid #343841;
		border-radius: 0.75rem;
		background-color: #0d0f14;
		color: #f2f6fa;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
		overflow: hidden;
	}

	.preonus-search-dialog::backdrop {
		background: rgba(6, 9, 19, 0.72);
		backdrop-filter: blur(4px);
	}

	.preonus-search-input-wrap {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid #23262d;
	}

	.preonus-search-input-icon {
		width: 1.1rem;
		height: 1.1rem;
		color: #858b98;
		flex-shrink: 0;
	}

	.preonus-search-input {
		width: 100%;
		background: transparent;
		border: none;
		outline: none;
		color: #f2f6fa;
		font-size: 0.95rem;
		font-family: Inter, inter-fallback, system-ui, sans-serif;
	}

	.preonus-search-input::placeholder {
		color: #858b98;
	}

	.preonus-search-esc {
		font-size: 0.7rem;
		padding: 0.2rem 0.45rem;
		border-radius: 0.3rem;
		border: 1px solid #343841;
		background: #17191e;
		color: #858b98;
		cursor: pointer;
	}

	.preonus-search-results {
		max-height: 24rem;
		overflow-y: auto;
		padding: 0.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	:global(.preonus-search-item) {
		display: block;
		padding: 0.65rem 0.75rem;
		border-radius: 0.5rem;
		text-decoration: none;
		color: #f2f6fa;
		transition: background-color 120ms ease;
	}

	:global(.preonus-search-item:hover),
	:global(.preonus-search-item.is-active) {
		background-color: #17191e;
	}

	:global(.preonus-search-item-top) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	:global(.preonus-search-item-title) {
		font-weight: 500;
		font-size: 0.9rem;
	}

	:global(.preonus-search-item-badge) {
		font-size: 0.7rem;
		padding: 0.12rem 0.48rem;
		border-radius: 9999px;
		background: #23262d;
		color: #bfc1c9;
		border: 1px solid #343841;
		flex-shrink: 0;
	}

	:global(.preonus-search-item-excerpt) {
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		color: #858b98;
		line-height: 1.45;
	}

	:global(.preonus-search-item mark) {
		background-color: rgba(167, 139, 250, 0.22);
		color: #f2f6fa;
		border-radius: 0.2rem;
		padding: 0 0.15rem;
	}

	:global(.preonus-search-empty) {
		padding: 2rem 1rem;
		text-align: center;
		color: #858b98;
		font-size: 0.9rem;
	}

	.preonus-search-footer {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 1rem;
		border-top: 1px solid #23262d;
		font-size: 0.75rem;
		color: #858b98;
	}

	.preonus-search-footer kbd {
		padding: 0.05rem 0.3rem;
		border-radius: 0.25rem;
		border: 1px solid #343841;
		background: #17191e;
		margin-right: 0.25rem;
	}
</style>
