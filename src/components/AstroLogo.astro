---
interface Props {
	class?: string;
	[key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['inline-flex items-center gap-2.5', className]} {...rest}>
	<svg
		width="28"
		height="28"
		viewBox="0 0 32 32"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		class="shrink-0"
	>
		<defs>
			<linearGradient id="preonus-logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
				<stop offset="0%" stop-color="#BC52EE" />
				<stop offset="100%" stop-color="#3245FF" />
			</linearGradient>
		</defs>
		<rect width="32" height="32" rx="7" fill="url(#preonus-logo-grad)" />
		<path
			d="M10 7H18C21.3137 7 24 9.68629 24 13C24 16.3137 21.3137 19 18 19H14.5V25H10V7ZM14.5 11.5V14.5H18C18.8284 14.5 19.5 13.8284 19.5 13C19.5 12.1716 18.8284 11.5 18 11.5H14.5Z"
			fill="white"
		/>
	</svg>
	<span class="font-heading text-xl font-bold tracking-tight text-white">Preonus</span>
</div>
