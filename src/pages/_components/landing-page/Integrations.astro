---
import SectionCopy from '../SectionCopy.astro';
import CodeExample from './integrations-tabs/CodeExample.astro';
import InterfaceExample from './integrations-tabs/InterfaceExample.astro';
---

<section class="mt-20 md:mt-24 lg:mt-28 xl:mt-36 relative">
	<div class="w-full max-w-screen-xl mx-auto px-4 sm:px-8">
		<SectionCopy
			label="Language Support"
			title="Java and Kotlin"
			description="Build services using modern Java or idiomatic Kotlin—with clean annotations and seamless interoperability."
		/>
	</div>

	<div class="mx-auto w-full max-w-screen-xl">
		<div
			role="tablist"
			aria-label="Select a language"
			class="mt-4 py-1 sm:mt-8 px-4 sm:px-8 w-full flex items-center overflow-x-auto text-nowrap no-scrollbar gap-4 sm:gap-6"
		>
			{/* Java Tab */}
			<button
				role="tab"
				id="tab-java"
				data-lang="java"
				aria-selected="true"
				tabindex="0"
				class="integration-tab group relative flex flex-col items-center gap-3 whitespace-nowrap rounded-lg"
			>
				<div
					class="size-fit landing-section rounded-full p-0.5 lg:p-1 bg-astro-dark-100 group-hover:bg-astro-gray-200 group-aria-selected:bg-[#ED8B00] transition-all duration-300 ease-in-out"
				>
					<div class="bg-black size-12 lg:size-16 landing-section rounded-full">
						<div
							class="w-full h-full landing-section rounded-full bg-astro-dark-100/20 group-aria-selected:bg-[#ED8B00]/20 flex items-center justify-center p-2.5 transition-colors duration-300"
						>
							<img
								src="https://vinitshinde.netlify.app/icons/skills/java.svg"
								alt="Java Logo"
								class="size-6 lg:size-8 object-contain"
								loading="lazy"
							/>
						</div>
					</div>
				</div>
				<p
					class="font-medium text-base text-astro-gray-300 group-hover:text-astro-gray-200 group-aria-selected:text-[#ED8B00] transition-all duration-300 ease-in-out"
				>
					Java
				</p>
			</button>

			{/* Kotlin Tab */}
			<button
				role="tab"
				id="tab-kotlin"
				data-lang="kotlin"
				aria-selected="false"
				tabindex="-1"
				class="integration-tab group relative flex flex-col items-center gap-3 whitespace-nowrap rounded-lg"
			>
				<div
					class="size-fit landing-section rounded-full p-0.5 lg:p-1 bg-astro-dark-100 group-hover:bg-astro-gray-200 group-aria-selected:bg-[#7F52FF] transition-all duration-300 ease-in-out"
				>
					<div class="bg-black size-12 lg:size-16 landing-section rounded-full">
						<div
							class="w-full h-full landing-section rounded-full bg-astro-dark-100/20 group-aria-selected:bg-[#7F52FF]/20 flex items-center justify-center p-2.5 transition-colors duration-300"
						>
							{/* Official Kotlin Diagonal Logo */}
							<svg xmlns="http://www.w3.org/2000/svg" class="size-6 lg:size-8" viewBox="0 0 128 128" aria-label="Kotlin Logo">
								<defs>
									<linearGradient id="officialKotlinGrad" x1="0%" y1="100%" x2="100%" y2="0%">
										<stop offset="0%" stop-color="#E44857"/>
										<stop offset="46.5%" stop-color="#C711E1"/>
										<stop offset="100%" stop-color="#7F52FF"/>
									</linearGradient>
								</defs>
								<path fill="url(#officialKotlinGrad)" d="M128 128H0V0h128L64 64z"/>
							</svg>
						</div>
					</div>
				</div>
				<p
					class="font-medium text-base text-astro-gray-300 group-hover:text-astro-gray-200 group-aria-selected:text-[#7F52FF] transition-all duration-300 ease-in-out"
				>
					Kotlin
				</p>
			</button>
		</div>
	</div>

	<div class="my-4 sm:my-8 w-full border-t border-t-astro-gray-600"></div>

	<div class="mx-auto w-full max-w-screen-xl px-4 sm:px-8">
		<section
			role="tabpanel"
			aria-labelledby="tab-java"
			class:list={['mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4']}
		>
			<div class="lg:col-span-2">
				<CodeExample />
			</div>

			{/* Response window frame */}
			<div class="order-first sm:order-last h-fit lg:-mt-[4.5rem] bg-[#07040F] border border-astro-gray-600 rounded-2xl">
				{/* Window control bar */}
				<div class="h-[2.438rem] px-3 flex items-center whitespace-no-wrap pointer-events-none select-none border-b border-b-astro-gray-600">
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
					<span class="mx-1 inline-block h-3 w-3 rounded-full bg-astro-gray-600"></span>
				</div>

				<div class="h-[21.5rem] md:max-lg:h-[18rem] xl:h-[26.3rem] overflow-hidden">
					<InterfaceExample />
				</div>
			</div>
		</section>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.integration-tab');
	const panel = document.querySelector<HTMLElement>('[role="tabpanel"]')!;
	const javaCodePanel = document.getElementById('code-panel-java');
	const kotlinCodePanel = document.getElementById('code-panel-kotlin');

	let activeTabIndex = 0;

	function updateTabSelection(index: number) {
		const nextTab = tabs[index];
		const activeTab = tabs[activeTabIndex];

		activeTab.setAttribute('aria-selected', 'false');
		activeTab.setAttribute('tabindex', '-1');

		nextTab.setAttribute('aria-selected', 'true');
		nextTab.setAttribute('tabindex', '0');

		panel.setAttribute('aria-labelledby', nextTab.id);

		const lang = nextTab.getAttribute('data-lang');
		if (lang === 'kotlin') {
			javaCodePanel?.classList.add('hidden');
			kotlinCodePanel?.classList.remove('hidden');
		} else {
			kotlinCodePanel?.classList.add('hidden');
			javaCodePanel?.classList.remove('hidden');
		}

		tabs[index].focus();
		activeTabIndex = index;
	}

	tabs.forEach((tab, index) => {
		tab.addEventListener('click', () => updateTabSelection(index));

		tab.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				const nextIndex = (activeTabIndex + 1) % tabs.length;
				updateTabSelection(nextIndex);
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				const prevIndex = (activeTabIndex - 1 + tabs.length) % tabs.length;
				updateTabSelection(prevIndex);
			}
		});
	});
</script>
