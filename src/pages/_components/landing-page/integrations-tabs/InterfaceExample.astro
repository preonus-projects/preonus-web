---
---

<div
	class="size-full flex flex-col justify-between p-5 sm:p-6 font-mono select-none"
	aria-hidden="true"
>
	{/* Top section: Request Badge & Method/Path */}
	<div class="space-y-4">
		<div class="flex items-center justify-between gap-2 border-b border-astro-gray-600/50 pb-3">
			<div class="flex items-center gap-2">
				<span class="px-2 py-0.5 rounded text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
					GET
				</span>
				<span class="text-sm text-astro-gray-200">
					/hello/preonus
				</span>
			</div>
			<span class="px-2 py-0.5 rounded text-xs font-medium bg-astro-dark-100 text-astro-gray-300 border border-astro-gray-600/40">
				200 OK
			</span>
		</div>

		{/* Response Payload Display */}
		<div class="space-y-2">
			<p class="text-xs uppercase tracking-wider text-astro-gray-400 font-sans font-semibold">Response Body</p>
			<div class="p-3.5 bg-astro-dark-800/80 rounded-xl border border-astro-dark-100/40">
				<p class="text-sm sm:text-base text-astro-green font-medium">
					"Hello, preonus from Preonus!"
				</p>
			</div>
		</div>
	</div>

	{/* Bottom Status Pill */}
	<div class="pt-4 flex items-center justify-center">
		<div class="px-3 py-1.5 rounded-full bg-astro-dark-900 border border-astro-gray-500/30 flex items-center gap-2 shadow-sm">
			<span class="size-2 rounded-full bg-astro-green animate-pulse"></span>
			<span class="text-xs font-sans text-astro-gray-300 font-medium">
				Zero-Reflection Build-Time Wiring
			</span>
		</div>
	</div>
</div>
