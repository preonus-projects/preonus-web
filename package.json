{
	"name": "@example/minimal",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format --write && prettier -w \"**/*.astro\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --linter-enabled=false --write",
		"format-unsafe": "biome check --write --unsafe",
		"typecheck": "astro check"
	},
	"dependencies": {
		"@astro-community/astro-embed-youtube": "^0.5.10",
		"@astrojs/check": "0.9.12",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.6",
		"@astrojs/starlight": "^0.43.1",
		"@astrojs/tailwind": "^6.0.2",
		"@biomejs/biome": "2.6.8",
		"@preact/signals-core": "^1.14.5",
		"@tailwindcss/container-queries": "^0.1.1",
		"@types/node": "^26.6.6",
		"astro": "^7.4.13",
		"astro-embed": "^0.14.0",
		"astro-expressive-code": "^0.44.4",
		"astro-icon": "^1.2.0",
		"chart.js": "4.4.8",
		"date-fns": "^4.4.0",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"sharp": "^0.35.5",
		"smartypants": "^0.2.2",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"xss": "^1.0.17"
	},
	"devDependencies": {
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-to-string": "^4.0.0",
		"yaml": "^2.9.1"
	},
	"packageManager": "pnpm@11.28.13"
}
